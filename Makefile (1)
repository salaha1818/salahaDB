# Usage: make -C bench && ./bench/bench 1000 5000 10000
# Needs libsqlite3-dev (sudo apt install libsqlite3-dev) or pass SQLITE_INC/SQLITE_LIB.
CXX      ?= g++
SQLITE_INC ?=
SQLITE_LIB ?= -lsqlite3
SRC := $(filter-out ../src/main.cpp,$(wildcard ../src/*.cpp))

bench: bench.cpp $(SRC)
	$(CXX) -std=c++20 -O2 -I../include $(SQLITE_INC) bench.cpp $(SRC) $(SQLITE_LIB) -o bench

clean:
	rm -f bench
